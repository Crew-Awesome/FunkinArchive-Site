{
  "name": "funkin-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler pages dev dist",
    "build": "tsc -b && vite build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist",
    "db:setup:local": "wrangler d1 execute DB --local --file=setup.sql",
    "db:setup:remote": "wrangler d1 execute DB --remote --file=setup.sql",
    "types:cloudflare": "wrangler types worker-configuration.d.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.167.0"
  }
}
